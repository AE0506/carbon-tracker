/* app.wxss — 全局样式（WXSS 不支持 * 通配符） */
page {
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  background: #f4f8f4;
  font-size: 28rpx;
  color: #26352d;
  box-sizing: border-box;
}
view,
text,
input,
button,
image,
scroll-view,
swiper,
swiper-item {
  box-sizing: border-box;
}
button {
  font-family: inherit;
}
button::after {
  border: none;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin: 0 30rpx 24rpx;
  box-shadow: 0 14rpx 42rpx rgba(22, 88, 54, 0.08);
  border: 1rpx solid rgba(31, 122, 74, 0.06);
  animation: cardIn 0.36s ease both;
}
.sec-title {
  font-size: 26rpx;
  color: #65746b;
  font-weight: 700;
  padding: 32rpx 30rpx 16rpx;
  letter-spacing: 0.5rpx;
}
.prog-track {
  height: 12rpx;
  background: #eaf1ed;
  border-radius: 999rpx;
  overflow: hidden;
}
.prog-fill {
  height: 100%;
  background: linear-gradient(90deg, #1a7a4a, #39bd78);
  border-radius: 999rpx;
  transition: width 0.5s ease;
  animation: progGlow 1.8s ease-in-out infinite alternate;
}
.badge-lv {
  background: #e7f6ed;
  color: #14693e;
  border-radius: 999rpx;
  padding: 5rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.badge-low {
  background: #e7f6ed;
  color: #14693e;
  border-radius: 999rpx;
  padding: 5rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge-med {
  background: #fff6df;
  color: #b36a00;
  border-radius: 999rpx;
  padding: 5rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge-high {
  background: #fff0eb;
  color: #bd4127;
  border-radius: 999rpx;
  padding: 5rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.divider-bar {
  height: 18rpx;
  background: #f4f8f4;
}
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 104rpx 40rpx;
  color: #a8b7ae;
  gap: 20rpx;
  animation: cardIn 0.35s ease both;
}
.empty-icon {
  font-size: 84rpx;
  line-height: 1;
  opacity: 0.86;
}
.empty-text {
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}
.safe-bottom {
  height: calc(44rpx + env(safe-area-inset-bottom));
}

.tap-soft {
  opacity: 0.9;
  transform: scale(0.985);
}
.tap-card {
  opacity: 0.94;
  transform: translateY(2rpx) scale(0.985);
}
.tap-icon {
  opacity: 0.86;
  transform: scale(0.94);
}

@keyframes pageIn {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes floatLeaf {
  0%,
  100% {
    transform: translateY(0) rotate(-2deg);
  }
  50% {
    transform: translateY(-8rpx) rotate(2deg);
  }
}
@keyframes softPulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.92;
  }
  50% {
    transform: scale(1.045);
    opacity: 1;
  }
}
@keyframes progGlow {
  from {
    box-shadow: 0 0 0 rgba(57, 189, 120, 0);
  }
  to {
    box-shadow: 0 0 18rpx rgba(57, 189, 120, 0.3);
  }
}
@keyframes barRise {
  from {
    transform: scaleY(0.12);
    opacity: 0.35;
  }
  to {
    transform: scaleY(1);
    opacity: 1;
  }
}
@keyframes sproutPop {
  0% {
    transform: scale(0.72) translateY(10rpx);
    opacity: 0;
  }
  70% {
    transform: scale(1.08) translateY(-2rpx);
    opacity: 1;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}
@keyframes shimmer {
  0% {
    background-position: 160% 0;
  }
  100% {
    background-position: -160% 0;
  }
}
