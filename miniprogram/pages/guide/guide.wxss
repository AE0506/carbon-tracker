.guide-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eaf7ef 0, #f4f8f4 360rpx);
  animation: pageIn 0.32s ease both;
}

.guide-hdr {
  background: linear-gradient(145deg, #0f5f3a 0%, #1a7a4a 58%, #34b873 100%);
  color: white;
  padding: 38rpx 24rpx 42rpx;
  text-align: center;
  border-radius: 0 0 34rpx 34rpx;
  box-shadow: 0 18rpx 46rpx rgba(26, 122, 74, 0.18);
}

.gh-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
  animation: floatLeaf 2.8s ease-in-out infinite;
}

.gh-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.gh-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

.category-bar {
  background-color: white;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eaf1ed;
  box-shadow: 0 10rpx 28rpx rgba(22, 88, 54, 0.05);
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 15rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background-color: #f1f5f2;
  color: #5d6a62;
  transition: all 0.18s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #1a7a4a, #31b873);
  color: white;
  font-weight: 700;
  box-shadow: 0 8rpx 22rpx rgba(26, 122, 74, 0.18);
}

.guide-content {
  padding: 24rpx 24rpx 18rpx;
}

.guide-card {
  background: white;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 34rpx rgba(22, 88, 54, 0.07);
  border: 1rpx solid rgba(31, 122, 74, 0.05);
  display: flex;
  align-items: flex-start;
  animation: cardIn 0.34s ease both;
}

.gc-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #e8f7ef;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: sproutPop 0.36s ease both;
}

.gc-content {
  flex: 1;
}

.gc-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #26352d;
  margin-bottom: 12rpx;
}

.gc-desc {
  font-size: 24rpx;
  color: #596860;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.gc-tips {
  margin-top: 12rpx;
}

.gc-tip {
  font-size: 22rpx;
  color: #7d8a82;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

/* 全局 .safe-bottom 已定义在 app.wxss，删除此处覆盖 */
