.lb-page {
  background: linear-gradient(180deg, #eaf7ef 0, #f4f8f4 360rpx);
  min-height: 100vh;
  animation: pageIn 0.32s ease both;
}
.lb-hdr {
  background: linear-gradient(150deg, #0f5f3a, #1a7a4a 58%, #35b772);
  padding: 30rpx 30rpx 42rpx;
  color: #fff;
  text-align: center;
  border-radius: 0 0 34rpx 34rpx;
  box-shadow: 0 18rpx 46rpx rgba(26, 122, 74, 0.18);
}
.lb-hdr-t {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}
.lb-hdr-s {
  font-size: 22rpx;
  opacity: 0.8;
}
.my-rank-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 30rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  margin-top: 12rpx;
}
.tab-row {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #edf2ee;
  box-shadow: 0 10rpx 28rpx rgba(22, 88, 54, 0.05);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  font-size: 26rpx;
  color: #87938b;
  position: relative;
  transition: all 0.18s ease;
}
.tab-on {
  color: #1a7a4a;
  font-weight: 700;
}
.tab-on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: #1a7a4a;
  border-radius: 2rpx;
}
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
  color: #bbb;
  gap: 16rpx;
}
.loading-icon {
  font-size: 48rpx;
}
.loading-text {
  font-size: 26rpx;
}
.top3-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 16rpx;
  background: #fff;
  padding: 34rpx 20rpx 8rpx;
  margin: 18rpx 24rpx 16rpx;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 38rpx rgba(22, 88, 54, 0.08);
}
.top3-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  animation: cardIn 0.34s ease both;
}
.t1 {
  margin-bottom: 0;
}
.t2,
.t3 {
  margin-bottom: 20rpx;
}
.top3-crown {
  font-size: 32rpx;
}
.top3-av {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8f5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: 3rpx solid #ddd;
}
.top3-av.big {
  width: 100rpx;
  height: 100rpx;
  font-size: 40rpx;
  border-color: #f0c040;
  box-shadow: 0 0 22rpx rgba(240, 192, 64, 0.34);
  animation: softPulse 2.3s ease-in-out infinite;
}
.top3-name {
  font-size: 22rpx;
  color: #333;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.top3-pts {
  font-size: 22rpx;
  color: #888;
  font-weight: 600;
}
.top3-pts.gold {
  color: #f0a500;
}
.lb-rows {
  background: #fff;
  padding: 0 20rpx;
  margin: 0 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(22, 88, 54, 0.07);
  overflow: hidden;
}
.lb-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.lb-row:last-child {
  border: none;
}
.lb-me {
  background: #f0faf5;
  margin: 0 -20rpx;
  padding: 20rpx;
}
.lb-rank {
  width: 44rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #aaa;
  text-align: center;
}
.lb-rank-top {
  color: #f0a500;
}
.lb-av {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e8f5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}
.lb-info {
  flex: 1;
}
.lb-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}
.lb-sub {
  font-size: 20rpx;
  color: #aaa;
  margin-top: 3rpx;
}
.lb-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a7a4a;
}
.lb-unit {
  font-size: 18rpx;
  color: #aaa;
  margin-left: 2rpx;
}
.share-wrap {
  padding: 24rpx 30rpx;
}
.share-btn {
  background: linear-gradient(135deg, #1a7a4a, #31b873) !important;
  color: #fff !important;
  border-radius: 22rpx !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  border: none !important;
  height: 90rpx !important;
  line-height: 90rpx !important;
  box-shadow: 0 16rpx 36rpx rgba(26, 122, 74, 0.22);
}
.share-btn::after {
  border: none !important;
}
