.learn-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eaf7ef 0, #f4f8f4 360rpx);
  animation: pageIn 0.32s ease both;
}
.learn-hdr {
  background: linear-gradient(150deg, #0f5f3a, #1a7a4a 58%, #35b772);
  padding: 42rpx 30rpx 48rpx;
  text-align: center;
  color: #fff;
  border-radius: 0 0 34rpx 34rpx;
  box-shadow: 0 18rpx 46rpx rgba(26, 122, 74, 0.18);
}
.lh-icon {
  font-size: 66rpx;
  line-height: 1;
  animation: floatLeaf 2.8s ease-in-out infinite;
}
.lh-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 16rpx;
}
.lh-sub {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}
.quiz-bar {
  margin: 24rpx 30rpx;
  background: #fff;
  border-radius: 26rpx;
  padding: 25rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 14rpx 38rpx rgba(22, 88, 54, 0.08);
  border: 1rpx solid rgba(31, 122, 74, 0.05);
  transition: all 0.18s ease;
  animation: cardIn 0.34s ease both;
}
.qb-l {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.qb-icon {
  font-size: 48rpx;
}
.qb-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.qb-sub {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}
.qb-btn {
  background: linear-gradient(135deg, #1a7a4a, #31b873);
  color: #fff;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}
.quiz-result {
  margin: 24rpx 30rpx;
  background: linear-gradient(135deg, #f0a500, #f5c842);
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  color: #fff;
}
.qr-icon {
  font-size: 48rpx;
}
.qr-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
}
.qr-score {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 8rpx;
}
.sec-title {
  padding: 24rpx 30rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
}
.article-list {
  padding: 0 30rpx;
}
.article-card {
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  padding: 25rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 88, 54, 0.07);
  transition: all 0.18s ease;
  animation: cardIn 0.34s ease both;
}
.ac-icon {
  font-size: 48rpx;
}
.ac-info {
  flex: 1;
}
.ac-title {
  font-size: 30rpx;
  font-weight: 700;
}
.ac-sub {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}
.ac-arr {
  font-size: 32rpx;
  opacity: 0.5;
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.article-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -16rpx 50rpx rgba(0, 0, 0, 0.12);
  animation: sheetUp 0.3s ease both;
  padding-bottom: env(safe-area-inset-bottom);
}
.ap-hdr {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.aph-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.aph-info {
  flex: 1;
}
.aph-title {
  font-size: 32rpx;
  font-weight: 700;
}
.aph-sub {
  font-size: 22rpx;
  opacity: 0.6;
  margin-top: 4rpx;
}
.aph-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #888;
}
.ap-body {
  flex: 1;
  padding: 24rpx 30rpx;
}
.sec-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 24rpx;
}
.sec-tip {
  background: #e8f5ee;
  color: #1a7a4a;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.sec-fact {
  background: #fff8e8;
  color: #f0a500;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.compare-list {
  margin-bottom: 24rpx;
}
.compare-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.cr-icon {
  font-size: 40rpx;
}
.cr-info {
  flex: 1;
}
.cr-way {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.cr-emission {
  font-size: 24rpx;
  color: #1a7a4a;
  margin-top: 4rpx;
}
.cr-benefit {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}
.tips-list {
  margin-bottom: 24rpx;
}
.tip-item {
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.ti-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a7a4a;
  margin-bottom: 6rpx;
}
.ti-detail {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}
.challenge-list {
  margin-bottom: 24rpx;
}
.challenge-item {
  background: #f3e8ff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.ci-week {
  font-size: 22rpx;
  color: #9b59b6;
  margin-bottom: 4rpx;
}
.ci-theme {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 4rpx;
}
.ci-desc {
  font-size: 24rpx;
  color: #666;
}
.quiz-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: calc(100vw - 80rpx);
  max-width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  z-index: 101;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.18);
  animation: cardIn 0.28s ease both;
}
.qp-hdr {
  background: linear-gradient(135deg, #1a7a4a, #31b873);
  color: #fff;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 28rpx 28rpx 0 0;
}
.qp-body {
  padding: 30rpx;
}
.qp-q {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  margin-bottom: 24rpx;
}
.qp-options {
  margin-bottom: 20rpx;
}
.qp-opt {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  transition: all 0.18s ease;
}
.qp-opt.correct {
  background: #e8f5ee;
  color: #1a7a4a;
  font-weight: 600;
}
.qp-opt.wrong {
  background: #fef0eb;
  color: #e05c3a;
}
.qp-exp {
  background: #fff8e8;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #f0a500;
  margin-bottom: 20rpx;
}
.qp-next {
  background: linear-gradient(135deg, #1a7a4a, #31b873);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.18s ease;
}
@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
