.stats-page {
  background: linear-gradient(180deg, #eff8f2 0, #f4f8f4 320rpx);
  min-height: 100vh;
  animation: pageIn 0.32s ease both;
}
.error-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #fff3f0;
  border: 2rpx solid #ffccc7;
  color: #e05c3a;
  padding: 16rpx 24rpx;
  margin: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}
.retry-btn {
  background: #e05c3a;
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.sum-row {
  display: flex;
  gap: 10rpx;
  padding: 22rpx 30rpx 0;
  flex-wrap: wrap;
}
.sum-box {
  flex: 1;
  min-width: calc(50% - 5rpx);
  background: #fff;
  border-radius: 22rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(22, 88, 54, 0.07);
  border: 1rpx solid rgba(31, 122, 74, 0.05);
  animation: cardIn 0.34s ease both;
}
.sum-n {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a7a4a;
}
.sum-l {
  font-size: 18rpx;
  color: #87938b;
  margin-top: 6rpx;
}
.insight-bar {
  margin: 18rpx 30rpx 0;
  background: linear-gradient(135deg, #e8f7ef, #fff);
  border: 1rpx solid rgba(26, 122, 74, 0.08);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  color: #14693e;
  line-height: 1.6;
  box-shadow: 0 10rpx 28rpx rgba(22, 88, 54, 0.06);
  animation: cardIn 0.34s 0.06s ease both;
}
.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 160rpx;
  margin-bottom: 16rpx;
}
.bc-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  height: 100%;
}
.bc-val {
  font-size: 18rpx;
  color: #888;
  min-height: 24rpx;
}
.bc-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
}
.bc-bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
  transform-origin: bottom;
  animation: barRise 0.45s ease both;
  box-shadow: 0 8rpx 18rpx rgba(26, 122, 74, 0.1);
}
.bc-lbl {
  font-size: 18rpx;
  color: #aaa;
}
.bc-today {
  color: #1a7a4a;
  font-weight: 700;
}
.legend-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
}
.leg {
  display: flex;
  align-items: center;
  gap: 7rpx;
  font-size: 20rpx;
  color: #888;
}
.leg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
}
.bh-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef3ef;
}
.bh-item:last-child {
  border: none;
}
.bh-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bh-info {
  flex: 1;
}
.bh-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}
.bh-track {
  margin-top: 10rpx;
}
.bh-pct {
  font-size: 24rpx;
  color: #888;
  font-weight: 500;
}
.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 16rpx 30rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 88, 54, 0.07);
  transition: all 0.18s ease;
}
.he-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.he-icon {
  font-size: 30rpx;
}
.he-txt {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}
.he-arr {
  font-size: 28rpx;
  color: #aaa;
}
