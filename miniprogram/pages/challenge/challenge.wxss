.chal-page {
  background: linear-gradient(180deg, #eaf7ef 0, #f4f8f4 360rpx);
  min-height: 100vh;
  animation: pageIn 0.32s ease both;
}
.today-chal {
  background: linear-gradient(150deg, #0d3d22, #1a7a4a 56%, #35b772);
  margin: 22rpx;
  border-radius: 30rpx;
  padding: 38rpx;
  color: #fff;
  box-shadow: 0 20rpx 52rpx rgba(26, 122, 74, 0.24);
  animation: cardIn 0.34s ease both;
}
.tc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.tc-kicker {
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 30rpx;
  padding: 7rpx 18rpx;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}
.tc-date {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}
.tc-icon-big {
  font-size: 82rpx;
  text-align: center;
  display: block;
  margin-bottom: 14rpx;
  animation: softPulse 2.2s ease-in-out infinite;
}
.tc-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 8rpx;
}
.tc-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  margin-bottom: 20rpx;
}
.tc-tip-box {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 24rpx;
}
.tc-tip-label {
  font-size: 22rpx;
}
.tc-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.7;
}
.tc-reward {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.tc-reward-lbl {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}
.tc-reward-pts {
  font-size: 32rpx;
  font-weight: 700;
  color: #a8ffc4;
}
.tc-status {
  font-size: 22rpx;
  border-radius: 30rpx;
  padding: 6rpx 18rpx;
}
.st-done {
  background: rgba(255, 255, 255, 0.2);
  color: #a8ffc4;
  font-weight: 600;
}
.st-todo {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
}
.tc-target {
  margin-bottom: 24rpx;
}
.tc-target-lbl {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 4rpx;
}
.tc-target-val {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}
.tc-btn {
  background: #a8ffc4 !important;
  color: #0d3d22 !important;
  border-radius: 22rpx !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  border: none !important;
  height: 90rpx !important;
  line-height: 90rpx !important;
  box-shadow: 0 14rpx 30rpx rgba(168, 255, 196, 0.18);
}
.tc-btn::after {
  border: none !important;
}
.tc-done-bar {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 14rpx;
  padding: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a8ffc4;
}
.prog-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  margin: 0 22rpx 18rpx;
  border-radius: 26rpx;
  padding: 28rpx;
  box-shadow: 0 14rpx 38rpx rgba(22, 88, 54, 0.08);
  border: 1rpx solid rgba(31, 122, 74, 0.05);
}
.prog-circle {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 6rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.4s;
}
.prog-done {
  background: #e8f5ee;
  border-color: #2d9e65;
  box-shadow: 0 0 20rpx rgba(45, 158, 101, 0.2);
}
.prog-inner {
  text-align: center;
}
.prog-em {
  font-size: 36rpx;
  line-height: 1;
}
.prog-pct {
  font-size: 22rpx;
  font-weight: 700;
  color: #222;
  margin-top: 4rpx;
}
.prog-lbl {
  font-size: 16rpx;
  color: #aaa;
}
.prog-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pi-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.pi-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}
.pi-txt {
  flex: 1;
  font-size: 24rpx;
  color: #555;
}
.pi-val {
  font-size: 24rpx;
  font-weight: 700;
}
.pi-yes {
  color: #1a7a4a;
}
.pi-no {
  color: #ccc;
}
.hist-section {
  background: #fff;
  margin: 0 22rpx 18rpx;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 38rpx rgba(22, 88, 54, 0.08);
  border: 1rpx solid rgba(31, 122, 74, 0.05);
}
.hist-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 28rpx;
  cursor: pointer;
  transition: all 0.18s ease;
}
.hist-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.hist-arrow {
  font-size: 20rpx;
  color: #aaa;
}
.hist-list {
  border-top: 1rpx solid #f5f5f5;
}
.hist-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.hist-item:last-child {
  border: none;
}
.hi-icon {
  font-size: 30rpx;
  width: 40rpx;
  text-align: center;
}
.hi-info {
  flex: 1;
}
.hi-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}
.hi-date {
  font-size: 20rpx;
  color: #aaa;
  margin-top: 2rpx;
}
.hi-status {
  font-size: 24rpx;
  font-weight: 600;
}
.hi-done {
  color: #1a7a4a;
}
.hi-miss {
  color: #ddd;
}
.all-chal-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 0 20rpx 20rpx;
}
.ac-item {
  width: calc(50% - 7rpx);
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 18rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 88, 54, 0.07);
  position: relative;
  box-sizing: border-box;
  border: 1rpx solid rgba(31, 122, 74, 0.05);
  animation: cardIn 0.34s ease both;
}
.ac-today {
  border: 2rpx solid #1a7a4a;
  background: linear-gradient(180deg, #f0faf5, #fff);
}
.ac-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.ac-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}
.ac-bonus {
  font-size: 20rpx;
  color: #1a7a4a;
  font-weight: 500;
}
.ac-today-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: #1a7a4a;
  color: #fff;
  font-size: 16rpx;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
}
