<scroll-view scroll-y class="idx-page" refresher-enabled bindrefresherrefresh="onPullDownRefresh">
  <view class="refresh-tip" wx:if="{{refreshing}}">正在刷新...</view>
  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="sk-wrap">
    <view class="sk-hdr"><view class="sk-line sk-w60"></view><view class="sk-circle"></view></view>
    <view class="sk-card"></view>
    <view class="sk-btn"></view>
    <view class="sk-row"><view class="sk-entry"></view><view class="sk-entry"></view></view>
    <view class="sk-title"></view>
    <view class="sk-grid"><view wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this" class="sk-dot"></view></view>
    <view class="sk-stats"><view wx:for="{{[1,2,3]}}" wx:key="*this" class="sk-stat"></view></view>
    <view class="sk-title"></view>
    <view class="sk-level"></view>
  </view>
  <view class="hdr" wx:if="{{!loading}}">
    <view class="hdr-circle c1"></view><view class="hdr-circle c2"></view>
    <view class="hdr-top">
      <view class="hdr-greet">你好，{{userInfo.nickname||'同学'}} 👋</view>
      <view class="hdr-av" hover-class="tap-icon" hover-stay-time="90" bindtap="goProfile">
        <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" class="av-img" mode="aspectFill"/>
        <view wx:else class="av-def">🌿</view>
      </view>
    </view>
    <view class="today-card">
      <view class="today-lbl">{{todayScored?'今天你种下了':'今天还没打卡'}}</view>
      <view class="today-row" wx:if="{{todayScored}}">
        <view class="today-em t-anim">{{todayTree.label==='小苗'?'🌱':todayTree.label==='小树'?'🌿':todayTree.label==='大树'?'🌳':'🌲'}}</view>
        <view class="today-info">
          <view class="today-label">一棵{{todayTree.label}}</view>
          <view class="today-sub">树木值 {{todayTree.treeValue}} · {{todayGrade.label}}</view>
          <view class="today-tiny">碳排分 {{todayScore}} 分</view>
        </view>
      </view>
      <view class="today-none" wx:else>
        <view class="none-icon">🌱</view>
        <view class="none-txt">完成打卡，种下今天的树</view>
      </view>
    </view>
  </view>
  <view class="sync-warn" wx:if="{{cloudOutOfSync}}">
    <text class="sync-warn-icon">⚠️</text>
    <text class="sync-warn-txt">数据未同步到云端，请检查网络</text>
  </view>
  <view class="qbtn" hover-class="tap-card" hover-stay-time="90" bindtap="goRecord">
    <view class="qb-l">
      <view class="qb-icon">✏️</view>
      <view><view class="qb-main">{{todayScored?'修改今日记录':'记录今日行为'}}</view><view class="qb-sub">点击选择，5 秒完成打卡</view></view>
    </view>
    <view class="qb-arr">›</view>
  </view>
  <view class="fentry" hover-class="tap-card" hover-stay-time="90" bindtap="goForest">
    <view class="fe-l"><view class="fe-icon">🌳</view><view><view class="fe-name">我的森林</view><view class="fe-sub">查看你种下的每棵树</view></view></view>
    <view class="fe-arr">›</view>
  </view>
  <!-- 快捷功能入口 -->
  <view class="quick-entries">
    <view class="qe-item" hover-class="tap-card" hover-stay-time="90" bindtap="goChallenge">
      <view class="qe-icon">⚡</view>
      <view class="qe-name">每日挑战</view>
      <view class="qe-sub">额外奖励积分</view>
    </view>
    <view class="qe-item" hover-class="tap-card" hover-stay-time="90" bindtap="goLeaderboard">
      <view class="qe-icon">🏆</view>
      <view class="qe-name">排行榜</view>
      <view class="qe-sub">和好友一起竞争</view>
    </view>
    <view class="qe-item" hover-class="tap-card" hover-stay-time="90" bindtap="goLearn">
      <view class="qe-icon">📚</view>
      <view class="qe-name">知识学院</view>
      <view class="qe-sub">学习低碳知识</view>
    </view>
    <view class="qe-item" hover-class="tap-card" hover-stay-time="90" bindtap="goGuide">
      <view class="qe-icon">🌿</view>
      <view class="qe-name">低碳建议</view>
      <view class="qe-sub">个性化低碳指南</view>
    </view>
  </view>
  <view class="sec-title">本周种树情况</view>
  <view class="card">
    <view class="wk-grid">
      <view wx:for="{{weekData}}" wx:key="index" class="wg-col">
        <view class="wg-box {{item.isToday?'wg-today':''}}">
          <text wx:if="{{item.scored}}" class="wg-em {{item.tree.size}}">{{item.tree.label==='小苗'?'🌱':item.tree.label==='小树'?'🌿':item.tree.label==='大树'?'🌳':'🌲'}}</text>
          <text wx:else class="wg-dot">·</text>
        </view>
        <view class="wg-lbl {{item.isToday?'wg-lbl-t':''}}">{{item.label}}</view>
      </view>
    </view>
    <view class="leg-row">
      <view class="leg"><view class="leg-d" style="background:#1a7a4a"></view><text>低碳</text></view>
      <view class="leg"><view class="leg-d" style="background:#f0a500"></view><text>一般</text></view>
      <view class="leg"><view class="leg-d" style="background:#e05c3a"></view><text>偏高</text></view>
    </view>
  </view>
  <view class="s3">
    <view class="s3i"><view class="s3n">{{weekStats.lowDays}}</view><view class="s3l">低碳天数</view></view>
    <view class="s3d"></view>
    <view class="s3i"><view class="s3n">{{weekStats.avgScore}}</view><view class="s3l">周均评分</view></view>
    <view class="s3d"></view>
    <view class="s3i"><view class="s3n">{{weekStats.streak}}</view><view class="s3l">连续打卡</view></view>
  </view>
  <view class="sec-title">我的等级</view>
  <view class="card" wx:if="{{levelProgress}}">
    <view class="lv-row"><view class="lv-name">{{levelProgress.lvInfo.name}}</view><view class="badge-lv">Lv.{{levelProgress.lvInfo.lv}}</view></view>
    <view class="lv-sub">{{levelProgress.lvInfo.title}}</view>
    <view class="prog-track" style="margin:16rpx 0 10rpx"><view class="prog-fill" style="width:{{levelProgress.pct}}%"></view></view>
    <view class="lv-pl"><text>{{levelProgress.current}} 积分</text><text>→ Lv.{{levelProgress.nextLvInfo.lv}} 需 {{levelProgress.next}} 分</text></view>
  </view>
  <view class="safe-bottom"></view>
</scroll-view>
