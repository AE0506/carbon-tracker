.hist-page {
  background: linear-gradient(180deg, #eaf7ef 0, #f4f8f4 340rpx);
  min-height: 100vh;
  animation: pageIn 0.32s ease both;
}
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(150deg, #0f5f3a, #1a7a4a 58%, #35b772);
  padding: 24rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 16rpx 42rpx rgba(26, 122, 74, 0.18);
}
.mn-arrow {
  font-size: 42rpx;
  color: rgba(255, 255, 255, 0.86);
  padding: 10rpx 20rpx;
  transition: all 0.18s ease;
}
.mn-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
.month-stats {
  display: flex;
  background: #fff;
  margin: 18rpx 24rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(22, 88, 54, 0.07);
  overflow: hidden;
}
.ms-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
}
.ms-n {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a7a4a;
}
.ms-l {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}
.ms-d {
  width: 1rpx;
  background: #f0f0f0;
}
.weekdays {
  display: flex;
  background: #fff;
  margin: 18rpx 24rpx 0;
  border-radius: 18rpx 18rpx 0 0;
  border-bottom: 1rpx solid #edf2ee;
  padding: 0 8rpx;
}
.wd {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #bbb;
  padding: 14rpx 0;
}
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
  color: #bbb;
  gap: 16rpx;
}
.loading-icon {
  font-size: 48rpx;
}
.loading-text {
  font-size: 26rpx;
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  padding: 10rpx;
  margin: 0 24rpx 2rpx;
  border-radius: 0 0 18rpx 18rpx;
}
.cal-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 14rpx;
  transition: all 0.18s ease;
}
.cal-empty {
  opacity: 0;
}
.cal-has-rec {
  cursor: pointer;
}
.cal-today {
  border: 2rpx solid #2d9e65;
  background: #f0faf5;
}
.cal-future {
  opacity: 0.35;
}
.cal-day {
  font-size: 22rpx;
  color: #333;
  line-height: 1;
}
.cal-day-rec {
  font-size: 18rpx;
  color: #1a7a4a;
  font-weight: 600;
}
.cal-tree {
  font-size: 24rpx;
  line-height: 1;
  animation: sproutPop 0.28s ease both;
}
.cal-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #eee;
}
.legend-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  background: #fff;
  margin-bottom: 16rpx;
}
.leg {
  display: flex;
  align-items: center;
  gap: 7rpx;
  font-size: 20rpx;
  color: #888;
}
.leg-d {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
}
.rec-list {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(22, 88, 54, 0.07);
  overflow: hidden;
}
.rec-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #edf2ee;
  transition: all 0.18s ease;
}
.rec-item:last-child {
  border: none;
}
.ri-date {
  font-size: 24rpx;
  color: #aaa;
  width: 80rpx;
  flex-shrink: 0;
}
.ri-tree {
  font-size: 36rpx;
  flex-shrink: 0;
}
.ri-info {
  flex: 1;
}
.ri-score {
  font-size: 26rpx;
  font-weight: 700;
}
.ri-sub {
  font-size: 20rpx;
  color: #aaa;
  margin-top: 3rpx;
}
.ri-arr {
  font-size: 28rpx;
  color: #ccc;
}
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
  pointer-events: none;
  transition: background 0.25s;
}
.ov-show {
  background: rgba(0, 0, 0, 0.52);
  pointer-events: auto;
}
.det-card {
  background: linear-gradient(180deg, #fff, #fbfefc);
  border-radius: 32rpx 32rpx 0 0;
  padding: 42rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
  width: 100%;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.34, 1.2, 0.64, 1);
  box-shadow: 0 -16rpx 50rpx rgba(0, 0, 0, 0.12);
}
.ov-card-show {
  transform: translateY(0);
}
.dc-emoji {
  font-size: 72rpx;
  text-align: center;
  display: block;
  margin-bottom: 10rpx;
}
.dc-date {
  font-size: 26rpx;
  color: #aaa;
  text-align: center;
  margin-bottom: 10rpx;
}
.dc-grade {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
  font-weight: 600;
  margin: 0 auto 24rpx;
  display: block;
  text-align: center;
  width: fit-content;
  margin: 0 auto 24rpx;
}
.dc-score-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.dc-score-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #222;
  line-height: 1;
}
.dc-tv-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a7a4a;
  line-height: 1;
}
.dc-score-lbl {
  font-size: 22rpx;
  color: #aaa;
}
.dc-behaviors {
  display: flex;
  justify-content: space-around;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.dc-bh {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.dc-bh-icon {
  font-size: 28rpx;
}
.dc-bh-txt {
  font-size: 20rpx;
  color: #555;
}
.dc-pts {
  text-align: center;
  font-size: 24rpx;
  color: #1a7a4a;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.dc-close {
  background: linear-gradient(135deg, #1a7a4a, #31b873);
  color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.18s ease;
}
