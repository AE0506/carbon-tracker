.tips-page {
  background: linear-gradient(180deg, #eaf7ef 0, #f4f8f4 300rpx);
  min-height: 100vh;
  animation: pageIn 0.32s ease both;
}
.search-bar {
  background: #fff;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #edf2ee;
  box-shadow: 0 10rpx 28rpx rgba(22, 88, 54, 0.05);
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f1f5f2;
  border-radius: 40rpx;
  padding: 15rpx 20rpx;
  gap: 12rpx;
  border: 1rpx solid rgba(31, 122, 74, 0.05);
}
.search-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}
.search-input::placeholder {
  color: #bbb;
}
.search-clear {
  font-size: 26rpx;
  color: #bbb;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}
.search-result-tip {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #888;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.cat-scroll {
  background: #fff;
}
.cat-row {
  display: flex;
  padding: 16rpx 20rpx;
  gap: 12rpx;
  white-space: nowrap;
}
.cat-btn {
  display: inline-block;
  padding: 11rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #7d8a82;
  background: #f1f5f2;
  white-space: nowrap;
  transition: all 0.18s ease;
}
.cat-on {
  background: linear-gradient(135deg, #1a7a4a, #31b873);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 8rpx 22rpx rgba(26, 122, 74, 0.18);
}
.tips-list {
  padding: 16rpx;
}
.tip-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 12rpx 34rpx rgba(22, 88, 54, 0.07);
  border: 1rpx solid rgba(31, 122, 74, 0.05);
  transition: all 0.18s ease;
  animation: cardIn 0.34s ease both;
}
.tip-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.tip-icon-wrap {
  width: 62rpx;
  height: 62rpx;
  background: #e8f5ee;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.tip-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.tip-cat-lbl {
  font-size: 20rpx;
  color: #aaa;
}
.tip-tag {
  display: inline-block;
  font-size: 18rpx;
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  font-weight: 500;
}
.tip-fav {
  font-size: 32rpx;
  line-height: 1;
  padding: 8rpx;
}
.tip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 10rpx;
  line-height: 1.5;
}
.tip-preview {
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
  pointer-events: none;
  transition: background 0.25s;
}
.ov-show {
  background: rgba(0, 0, 0, 0.52);
  pointer-events: auto;
}
.tip-detail {
  background: linear-gradient(180deg, #fff, #fbfefc);
  border-radius: 32rpx 32rpx 0 0;
  padding: 42rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
  width: 100%;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.34, 1.2, 0.64, 1);
  box-shadow: 0 -16rpx 50rpx rgba(0, 0, 0, 0.12);
}
.ov-card-show {
  transform: translateY(0);
}
.td-icon {
  font-size: 60rpx;
  text-align: center;
  display: block;
  margin-bottom: 16rpx;
}
.td-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  text-align: center;
  margin-bottom: 12rpx;
  line-height: 1.5;
}
.td-tag {
  display: inline-block;
  font-size: 20rpx;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  font-weight: 500;
  margin: 0 auto 24rpx;
  display: block;
  text-align: center;
  width: fit-content;
  margin: 0 auto 24rpx;
}
.td-body {
  font-size: 28rpx;
  color: #555;
  line-height: 1.9;
  margin-bottom: 32rpx;
}
.td-actions {
  display: flex;
  gap: 16rpx;
}
.td-fav-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.18s ease;
}
.fav-on {
  background: #fef0f0;
  color: #e05c3a;
}
.td-close {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #1a7a4a, #31b873);
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
  transition: all 0.18s ease;
}
